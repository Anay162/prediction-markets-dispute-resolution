# ============================================================
# contract-auditor environment variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/contract_auditor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                    # Used for text-embedding-3-small
PRIMARY_MODEL=claude-sonnet-4-20250514   # Model used for all analyzer calls
EMBEDDING_MODEL=text-embedding-3-small

# --- External data APIs ---
POLYGON_API_KEY=                         # Polygon.io for ticker/delisting checks
OPENCORPORATES_API_KEY=                  # OpenCorporates entity lookup

# --- App ---
APP_ENV=development                      # development | staging | production
SECRET_KEY=                              # Used for JWT signing — generate with: openssl rand -hex 32
API_KEY_SALT=                            # Used for API key hashing

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Sentry (optional in dev) ---
SENTRY_DSN=

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60       # Per API key
AUDIT_SYNC_MAX_CRITERIA_CHARS=2000      # Contracts larger than this are always async

# --- Scoring ---
# Leave blank to use defaults from code; set to override with DB weights
ACTIVE_SCORING_WEIGHT_VERSION=
