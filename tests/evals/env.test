# .env.test
# Test environment configuration.
# Used by pytest and CI for integration tests.
# No real API keys here — unit tests mock all LLM calls.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contract_auditor_test
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# These are fake keys — all LLM calls are mocked in unit tests.
# Integration tests that hit real APIs need real keys via CI secrets.
ANTHROPIC_API_KEY=sk-ant-test-fake-key-for-unit-tests
OPENAI_API_KEY=sk-test-fake-key-for-unit-tests

PRIMARY_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-small

SECRET_KEY=test-secret-key-not-for-production
API_KEY_SALT=test-salt-not-for-production

APP_ENV=test
LOG_LEVEL=WARNING

RATE_LIMIT_REQUESTS_PER_MINUTE=1000
AUDIT_SYNC_MAX_CRITERIA_CHARS=99999
